<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!--
        The desk.

        Everything physical lives in here: the sheet and the tools laid out
        beside it. The activity turns with the tablet, and this frame turns the
        opposite way by the same amount, so what it holds stays exactly where it
        was put on the glass — the drawing does not swing round to face you any
        more than paper does when you spin it.

        Its size is fixed at the panel's landscape geometry in code and never
        changes, which is the point: a canvas view that changed size would
        rebuild its buffers, and rebuilding them loses the paint layer.

        Only the glyphs on the buttons turn back to face the artist; see
        MainActivity.faceTheArtist.
    -->
    <FrameLayout
        android:id="@+id/deviceFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

    <com.symmetricalpalmtree.paintsprout.PaintCanvasView
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating tool rail. Its buttons are built in code (a loop over the
         tools, plus context-sensitive color/size/surface/selection actions),
         mirroring the Flutter reference's _ToolRail. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/railCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#F0FFFFFF"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="8dp"
                android:paddingHorizontal="4dp" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!--
        The mixing tray.

        It hangs off the colour swatch on the rail rather than docking to an edge
        of its own: the swatch is what the palette is *for*, so that button is
        where a painter reaches for it, and one control saying "this is the paint"
        beats a button and a tab a screen apart saying half of it each.

        Laid out at the frame's top-left and moved into place beside the swatch in
        code (MainActivity.placeTray) — the rail turns with the glass, and a
        palette anchored to a button has to go wherever that button went. Square,
        so turning its face back to the artist never changes where it sits.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/trayCard"
        android:layout_width="284dp"
        android:layout_height="284dp"
        android:layout_gravity="start|top"
        android:visibility="invisible"
        app:cardBackgroundColor="#F5FFFFFF"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp">

        <com.symmetricalpalmtree.paintsprout.TrayView
            android:id="@+id/tray"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShowRail"
        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="12dp"
        android:visibility="gone"
        app:icon="@drawable/ic_show"
        app:iconGravity="textStart"
        app:iconPadding="0dp" />

    </FrameLayout>

    <!--
        The layers panel.

        Outside deviceFrame on purpose, and the only piece of chrome that is. The
        tools are objects on the desk and stay where they were put; this is a
        thing you read, so it stays where you can read it — on your right,
        upright, however the tablet is turned. Being a sibling of the frame is
        the whole implementation: the activity rotates with you, so anything
        laid out in here is already in your space.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layerPanel"
        android:layout_width="248dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F5FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/layers_title"
                    android:textColor="#FF37474F"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/folderAdd"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/folders_add"
                    android:padding="8dp"
                    android:src="@drawable/ic_folder_add"
                    app:tint="#FF37474F" />

                <ImageButton
                    android:id="@+id/layerAdd"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/layers_add"
                    android:padding="8dp"
                    android:src="@drawable/ic_layer_add"
                    app:tint="#FF37474F" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="420dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layerList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
