<?xml version="1.0" encoding="utf-8"?>
<!-- The badge's backing, not the badge's border: a pin glyph drawn straight onto
     a cover would vanish wherever the cover itself is dark, so this is a small
     paper-white island under it that stays legible over ink the same way the
     card's own frame stays legible over the page. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/paperWhite" />
    <stroke android:width="1dp" android:color="@color/inkBlack" />
    <corners android:radius="6dp" />
</shape>
