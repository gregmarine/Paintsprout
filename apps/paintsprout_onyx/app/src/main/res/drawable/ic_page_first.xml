<?xml version="1.0" encoding="utf-8"?>
<!--
  Doubled chevrons read as "jump to the end" because that is what they do —
  ic_page_last is this same shape mirrored. One arrow already means "step";
  two side by side is the only way to say "skip the stepping" without a word.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M11 7l-5 5l5 5"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/inkBlack"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M17 7l-5 5l5 5"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/inkBlack"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>
