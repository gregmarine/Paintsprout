<?xml version="1.0" encoding="utf-8"?>
<!--
  The mirror of toolbar_background_bottom, for a bar that sits at the top of
  the page instead of the foot of it: the inset moves to the top so only the
  bottom edge shows. Same argument — on a panel with no shadow, a 1 dp line is
  the only thing that can separate chrome from the paper under it, and a stroke
  on all four sides would box the bar in and make it read as a button the width
  of the screen.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paperWhite" />
        </shape>
    </item>

    <item
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/inkBlack" />
        </shape>
    </item>

</layer-list>
