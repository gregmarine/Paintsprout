<?xml version="1.0" encoding="utf-8"?>
<!--
  The shelf. G1's version of this file was a deliberate placeholder — nothing
  here but a title bar and an empty-state message — because the index needed
  somewhere to land before there was anything to browse. This is the real
  screen: a breadcrumb trail standing in for a folder path (there is no
  filesystem to browse; SoilFile.kt is the only path constructor and folders
  live exclusively in the index), a grid of folder and sketchbook cards, and a
  bottom bar that never disappears even when the grid does — "New sketchbook"
  has to be reachable from an empty folder as much as a full one.

  The grid itself is not built here, because how many cards fit is not known
  until the grid area has been measured — see GridGeometry. gridContainer holds
  the grid as a runtime child beside emptyState, so emptyState survives being
  shown and hidden without the FrameLayout ever losing the one child it always
  keeps.

  The pager in the bottom bar is what a shelf has instead of scrolling. Every
  scroll on this panel is a full-screen repaint chasing a finger and settles
  somewhere nobody aimed for; a page of cards that replaces the last page costs
  one refresh and lands exactly where it was going.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite"
    android:paddingTop="@dimen/toolbar_top_guard">

    <LinearLayout
        android:id="@+id/breadcrumbBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- No horizontal padding on this bar: the buttons sit flush at the
             screen edge, matching the sibling app's chrome, and the toolbar
             button's own padding is what keeps a fingertip off the glyph. -->

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnUp"
            style="@style/Widget.Paintsprout.ToolbarButton"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/cd_library_up"
            android:visibility="gone" />

        <!-- The Kotlin builds the crumb buttons at runtime, one per folder from
             the library root down to the current one — a fixed set of views
             here would have to be padded out to some maximum nesting depth
             nobody could name a correct value for. HorizontalScrollView is the
             overflow answer instead of ellipsizing a crumb: a folder path is
             navigation, and a truncated crumb the reader can't tap back to
             would be a dead end with no visible way out. -->
        <HorizontalScrollView
            android:id="@+id/breadcrumbScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/breadcrumbContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </HorizontalScrollView>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/overflowButton"
            style="@style/Widget.Paintsprout.ToolbarButton"
            android:src="@drawable/ic_dots"
            android:contentDescription="@string/cd_library_overflow" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <FrameLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/screen_margin"
            android:text="@string/library_empty"
            android:textAppearance="@style/TextAppearance.Paintsprout.BodyLarge" />

    </FrameLayout>

    <!-- The pager takes the weight so it centres in whatever room the other
         buttons leave rather than sitting pinned to one side. The empty
         stretch to its left is not slack to tidy away — it is where Pinned
         and Recents land in G5, and closing it now would mean reopening it
         under a different layout later. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/toolbar_background_bottom">

        <LinearLayout
            android:id="@+id/pager"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnFirst"
                style="@style/Widget.Paintsprout.ToolbarButton"
                android:src="@drawable/ic_page_first"
                android:contentDescription="@string/cd_pager_first" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnPrev"
                style="@style/Widget.Paintsprout.ToolbarButton"
                android:src="@drawable/ic_page_prev"
                android:contentDescription="@string/cd_pager_prev" />

            <TextView
                android:id="@+id/pageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Paintsprout.BodyMedium" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnNext"
                style="@style/Widget.Paintsprout.ToolbarButton"
                android:src="@drawable/ic_page_next"
                android:contentDescription="@string/cd_pager_next" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnLast"
                style="@style/Widget.Paintsprout.ToolbarButton"
                android:src="@drawable/ic_page_last"
                android:contentDescription="@string/cd_pager_last" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnSort"
            style="@style/Widget.Paintsprout.ToolbarButton"
            android:src="@drawable/ic_filter"
            android:contentDescription="@string/cd_library_sort" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnNewFolder"
            style="@style/Widget.Paintsprout.ToolbarButton"
            android:src="@drawable/ic_folder_plus"
            android:contentDescription="@string/cd_library_new_folder" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnNewSketchbook"
            style="@style/Widget.Paintsprout.ToolbarButton"
            android:src="@drawable/ic_plus"
            android:contentDescription="@string/cd_library_new_sketchbook" />

    </LinearLayout>

</LinearLayout>
