<?xml version="1.0" encoding="utf-8"?>
<!--
  Two questions, because a sketchbook needs two things from the reader before
  it can exist: a name, and a mode. Page size and surface are still arc-1
  non-goals (no millimetres, no calibration, no surfaces), so those two are
  the whole screen. nameRule sits under the field rather than only surfacing
  as a rejected-input error, because the reader should know the boundary
  before they hit it — a rule discovered by violation reads as the app being
  difficult rather than the field being honest about what it accepts. The
  mode question belongs here and nowhere else because a book's mode is
  permanent once made (see `NewSketchbook.kt`'s KDoc on `raster`) — a choice
  that cannot be changed later has to be asked at the one moment it can still
  be answered, not tucked into a debug menu or inferred from a default.
  Raster is listed first and checked, since the experiment's verdict made it
  the kind of book the artist reaches for; Strokes stays as the second row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite"
    android:paddingTop="@dimen/toolbar_top_guard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Paintsprout.ToolbarButton"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/cd_nav_back" />

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="@string/new_sketchbook_title"
            android:textAppearance="@style/TextAppearance.Paintsprout.TitleLarge" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_sketchbook_name_label"
            android:textAppearance="@style/TextAppearance.Paintsprout.BodyLarge" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/nameField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/shape_bordered"
            android:padding="@dimen/dialog_field_padding"
            android:textSize="16sp"
            android:textColor="@color/inkBlack"
            android:textColorHint="@color/inkLight"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:hint="@string/new_sketchbook_name_hint" />

        <TextView
            android:id="@+id/nameRule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/new_sketchbook_name_rule"
            android:textAppearance="@style/TextAppearance.Paintsprout.Hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/new_sketchbook_mode_label"
            android:textAppearance="@style/TextAppearance.Paintsprout.BodyLarge" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/modeRaster"
                style="@style/Widget.Paintsprout.RadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:checked="true"
                android:text="@string/new_sketchbook_mode_raster" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/new_sketchbook_mode_raster_hint"
                android:textAppearance="@style/TextAppearance.Paintsprout.Hint" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/modeStrokes"
                style="@style/Widget.Paintsprout.RadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/new_sketchbook_mode_strokes" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/new_sketchbook_mode_strokes_hint"
                android:textAppearance="@style/TextAppearance.Paintsprout.Hint" />

        </RadioGroup>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/toolbar_background_bottom"
        android:paddingEnd="@dimen/screen_margin">

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Paintsprout.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCreate"
            style="@style/Widget.Paintsprout.FilledButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/new_sketchbook_create" />

    </LinearLayout>

</LinearLayout>
