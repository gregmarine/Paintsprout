<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Paintsprout Onyx</string>

    <!-- Bootstrap. "Preparing…" says nothing about what is actually happening
         (a first-run key mint, a repair, an unlock prompt already covers
         itself) because the one thing every one of those states has in common
         is that the reader should not act on this screen yet — that is the
         whole message, and naming the specific cause would be a fact this
         screen cannot promise stays true frame to frame. -->
    <string name="boot_preparing">Preparing…</string>

    <!-- A boot that failed. This is the launcher, so the alternative to a
         dialog is a crash the moment the icon is tapped, and an app that dies
         on launch reads as an app that ate the drawings. Retry is offered
         first because the failures we know about here are transient — a
         Keystore that is not awake yet after a reboot, a file still being
         written back by a restore — and closing loses nothing. -->
    <string name="boot_error_title">Couldn\'t open your library</string>
    <string name="boot_error_body">%1$s</string>
    <string name="boot_error_foreign">This library file isn\'t encrypted, so it didn\'t come from Paintsprout. It has been left exactly as it is.</string>
    <string name="retry">Retry</string>
    <string name="close_app">Close</string>

    <!-- Recovery key. Carried over from Paper v0's onboarding screen with the
         vocabulary substituted (notebook → sketchbook, the app's own name
         where Paper named itself, NSPT- → PSPT-) rather than rewritten, since
         the whole point of matching it is that this key behaves exactly like
         Paper's and deserves exactly as much weight put on reading it. -->
    <string name="recovery_title">Save your recovery key</string>
    <string name="recovery_body">Your sketchbooks are encrypted. This recovery key is the only way back into your library on a new device or after a reinstall. It is the only copy — write it down or save it in a password manager. Nobody can recover it for you.</string>
    <string name="recovery_copy">Copy</string>
    <string name="recovery_saved">I\'ve saved it</string>
    <string name="recovery_continue">Continue</string>
    <string name="recovery_copied">Recovery key copied</string>
    <string name="recovery_tick_first">Tick “I\'ve saved it” to continue</string>
    <string name="recovery_clip_label">Paintsprout recovery key</string>

    <!-- Unlock. Same carry-over as above; "Unlock Paintsprout" stands in for
         Paper's "Unlock Paper" the same way the app's own short name always
         will next to a screen that only has room for one word before the
         explanation. -->
    <string name="unlock_title">Unlock Paintsprout</string>
    <string name="unlock_body">Enter your recovery key to open your library on this device.</string>
    <string name="unlock_hint">PSPT-…</string>
    <string name="unlock_button">Unlock</string>
    <string name="unlock_wrong">That key didn\'t open your library. Try again.</string>
    <string name="unlock_checking">Checking…</string>
    <string name="unlock_locked_out">Too many attempts. Try again in %1$s.</string>

    <!-- The shelf (G2). The library screen itself: the breadcrumb trail
         standing in for a folder path, the grid of folder and sketchbook
         cards, the pager, and the actions that create, rename, move and
         delete both kinds of thing. library_empty is worded as an instruction
         now rather than a plain observation, because G2 is the phase where
         there is finally something the reader can do about it. The chrome
         speaks in Tabler outline icons throughout this screen and the two it
         hands off to — every button here draws a glyph, not a word — so a
         content description is not a courtesy label, it is the only place an
         icon button says what it is, and it is what a long-press reads out. -->
    <string name="cd_library_overflow">More</string>
    <string name="library_empty">Nothing here yet. Tap New sketchbook to start one.</string>
    <string name="cd_library_up">Up one folder</string>
    <string name="cd_library_sort">Sort</string>
    <string name="cd_library_new_folder">New folder</string>
    <string name="cd_library_new_sketchbook">New sketchbook</string>
    <string name="library_root">Library</string>

    <!-- Pinned and Recents (G5). Two modes of this same screen rather than two
         screens, so their strings borrow the shelf's own voice: a mode has a
         title where the crumb trail would be, a close where Up would be, and
         an empty state that tells the reader what to do about it rather than
         just naming what isn't there yet — library_empty already sets that
         precedent. Recents' two lines are what cardMeta shows instead of the
         page count while that mode is on, since a sketchbook can only be
         opened from one place at a time and the reader wants to know where. -->
    <string name="cd_library_pinned">Pinned</string>
    <string name="cd_library_recents">Recent</string>
    <string name="cd_library_close_mode">Back to the shelf</string>
    <string name="mode_title_pinned">Pinned</string>
    <string name="mode_title_recents">Recent</string>
    <string name="library_empty_pinned">Nothing pinned yet. Long-press a sketchbook to pin it.</string>
    <string name="library_empty_recents">Nothing opened yet.</string>
    <string name="action_pin">Pin</string>
    <string name="action_unpin">Unpin</string>
    <string name="recents_in_root">In Library</string>
    <string name="recents_in_folder">In %1$s</string>

    <string name="cd_pager_first">First page</string>
    <string name="cd_pager_prev">Previous page</string>
    <string name="cd_pager_next">Next page</string>
    <string name="cd_pager_last">Last page</string>

    <string name="cd_nav_back">Back</string>
    <string name="cd_nav_up">Up one folder</string>

    <string name="sort_title">Sort by</string>
    <string name="sort_name_asc">Name A–Z</string>
    <string name="sort_name_desc">Name Z–A</string>
    <string name="sort_modified_desc">Last worked on</string>
    <string name="sort_modified_asc">Least recently worked on</string>

    <string name="action_rename">Rename</string>
    <string name="action_move">Move</string>
    <string name="action_delete">Delete</string>

    <string name="new_sketchbook_title">New sketchbook</string>
    <string name="new_sketchbook_name_label">Name</string>
    <string name="new_sketchbook_name_hint">Sketchbook name</string>
    <string name="new_sketchbook_name_rule">Letters, numbers, spaces, hyphens, underscores and dots.</string>
    <string name="new_sketchbook_create">Create</string>
    <string name="new_sketchbook_creating">Creating…</string>
    <string name="new_sketchbook_duplicate">There\'s already a sketchbook called “%1$s” here.</string>
    <string name="new_sketchbook_failed_title">Couldn\'t make the sketchbook</string>
    <string name="new_sketchbook_failed">Nothing was added to your library. Try again.</string>
    <!-- The five specific answers to "why did nothing happen when I tapped
         Create". They are string resources rather than sentences inside
         NameRules because they are screen text like any other and belong where
         the rest of it can be read as a whole; NameRules hands back the id so
         it stays a pure function with no Context. The character rule is
         narrower than the storage needs on purpose — a name has to be readable
         off this panel and typeable again, or a library cannot be searched by
         the person who filled it. The 64 is spelled out here as well as in
         NameRules.MAX_CHARS; if one moves, move the other. -->
    <string name="name_problem_empty">The name can\'t be empty.</string>
    <string name="name_problem_padded">The name can\'t start or end with a space.</string>
    <string name="name_problem_reserved">That name is reserved.</string>
    <string name="name_problem_long">That name is too long — 64 characters at most.</string>
    <string name="name_problem_characters">Use letters, numbers, spaces, hyphens, underscores and dots.</string>
    <string name="name_problem_title">That name won\'t work</string>

    <string name="new_folder_title">New folder</string>
    <string name="new_folder_hint">Folder name</string>
    <string name="new_folder_create">Create</string>
    <string name="new_folder_duplicate">There\'s already a folder called “%1$s” here.</string>

    <string name="rename_title">Rename</string>
    <string name="rename_hint">Name</string>
    <string name="rename_duplicate_sketchbook">There\'s already a sketchbook called “%1$s” here.</string>
    <string name="rename_duplicate_folder">There\'s already a folder called “%1$s” here.</string>

    <string name="delete_sketchbook_title">Delete “%1$s”?</string>
    <string name="delete_sketchbook_body">The sketchbook and everything drawn in it go for good. This can\'t be undone.</string>
    <string name="delete_folder_title">Delete “%1$s”?</string>
    <string name="delete_folder_body_empty">The folder is empty, so nothing drawn goes with it.</string>
    <!-- The Kotlin builds the "3 sketchbooks and 1 folder" phrase and passes
         it in as %1$s — kept out of this string because the pluralisation
         (one thing, one kind, two kinds, and every count of each) is not
         something a single format string can carry honestly. -->
    <string name="delete_folder_body">%1$s inside will go with it, for good. This can\'t be undone.</string>
    <string name="delete_confirm">Delete</string>

    <!-- The pieces the delete-folder question is assembled from. Counting
         phrases are separate strings rather than one clever format because
         "1 sketchbook" and "3 sketchbooks" differ in more languages than
         English by more than an s, and a confirmation that garbles what it is
         about to destroy is worse than no count at all. -->
    <string name="count_sketchbook_one">1 sketchbook</string>
    <string name="count_sketchbooks">%1$d sketchbooks</string>
    <string name="count_folder_one">1 folder</string>
    <string name="count_folders">%1$d folders</string>
    <string name="count_joined">%1$s and %2$s</string>

    <string name="picker_move_here">Move here</string>
    <string name="picker_empty">No folders here</string>
    <string name="picker_title">Move “%1$s” to…</string>
    <string name="picker_collision_sketchbook">There\'s already a sketchbook called “%1$s” in that folder.</string>
    <string name="picker_collision_folder">There\'s already a folder called “%1$s” in that folder.</string>
    <string name="picker_into_self">A folder can\'t be moved inside itself.</string>
    <string name="move_problem_title">Couldn\'t move it</string>

    <string name="ok">OK</string>
    <string name="card_meta_pages_one">1 page</string>
    <string name="card_meta_pages">%1$d pages</string>
    <!-- The Kotlin picks between card_meta_pages_one and card_meta_pages
         itself rather than a <plurals> resource, so this stays a plain
         format string: pages · date. -->
    <string name="card_meta">%1$s · %2$s</string>

    <!-- "2 / 5". Spelled out as a resource rather than built in code so the
         separator is one decision in one place — the folder picker's pager
         reads exactly the same as the shelf's, and nothing about being on a
         different screen makes being on page two of five a different fact. -->
    <string name="pager_label">%1$d / %2$d</string>

    <!-- Debug menu, behind the library's overflow control. Release builds carry
         a no-op twin of the menu that never shows these — see
         src/release/…/library/DebugMenu.kt — so the strings still need to live
         here rather than in the debug source set alone, or the release build
         would fail to resolve them. -->
    <string name="debug_show_recovery_key">Show recovery key</string>
    <string name="debug_forget_cached_key">Forget cached key</string>
    <string name="debug_tools">Debug tools</string>
    <string name="debug_no_key_cached">(no key cached)</string>
    <string name="debug_forget_title">Forget the cached key?</string>
    <string name="debug_forget_body">Clears the cached recovery key and closes the app. The next launch will ask for the key. Your sketchbooks are untouched — but have the key to hand before you do this.</string>
    <string name="debug_forget_confirm">Forget and close</string>
    <string name="debug_forgotten">Forgotten — launch again</string>

    <!-- The page. Nothing here is a label the artist reads while drawing: the
         name and the page count are for glancing at between marks, and the rest
         are content descriptions, sheet titles, the question the trash asks
         before it takes a page, and the two things a sketchbook that will not
         open has to be able to say. Undo and redo have a finger gesture as well
         as a button — two fingers tapped twice, three for redo — and the button
         is what makes them discoverable, so the description is the plain verb
         and nothing about how else to reach it. -->
    <string name="cd_sketchbook_back">Back to the shelf</string>
    <string name="cd_sketchbook_pencil">Pencil</string>
    <string name="cd_sketchbook_eraser">Eraser</string>
    <string name="cd_sketchbook_undo">Undo</string>
    <string name="cd_sketchbook_redo">Redo</string>
    <string name="cd_sketchbook_delete_page">Delete this page</string>

    <!-- The page the trash is aimed at is named by its number, because that is
         the only name a page has and "Delete this page?" would be a question
         about whichever page the artist thinks they are on. The body says the
         one thing that makes this different from deleting a sketchbook: it can
         be taken back, and exactly how long for. -->
    <string name="delete_page_title">Delete page %1$d of %2$d?</string>
    <string name="delete_page_body">Everything drawn on it goes with it. Undo brings the page back until you close the sketchbook.</string>
    <string name="delete_page_confirm">Delete</string>
    <string name="sketchbook_opening">Opening\u2026</string>
    <string name="sketchbook_page_of">%1$d / %2$d</string>
    <string name="lead_sheet_title">Pencil</string>
    <string name="lead_hairline">Hairline (0.10 mm)</string>
    <string name="sketchbook_missing_title">This sketchbook is not here</string>
    <string name="sketchbook_missing_body">The card is on the shelf but the sketchbook it points to is missing. Nothing has been deleted \u2014 the file may be on another device, or may not have finished being made.</string>
    <string name="sketchbook_open_failed_title">This sketchbook would not open</string>
    <string name="sketchbook_open_failed_body">Something in the file could not be read. It has been left exactly as it is \u2014 nothing was changed and nothing was deleted.</string>

    <string name="close">Close</string>
    <string name="cancel">Cancel</string>
</resources>
